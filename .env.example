# Copy to .env and restart `npx expo start`. All optional.

# Referee server (npm run referee). Use your computer's LAN address so a phone can reach it.
# EXPO_PUBLIC_REFEREE_URL=http://192.168.1.20:8787

# Your Hyperliquid builder address. Real orders carry it as their builder code.
# The builder account needs at least 100 USDC of perps account value to receive fees.
# EXPO_PUBLIC_BUILDER_ADDRESS=0x...
# Fee in tenths of a basis point: 10 = 0.01%. Max 100 for perps.
# EXPO_PUBLIC_BUILDER_FEE=10
# Real trades go to mainnet (where Phantom's perps account lives) unless set to "testnet".
# EXPO_PUBLIC_HL_NETWORK=mainnet

# Where the web build is hosted. The phone app opens this inside Phantom to place real trades.
# EXPO_PUBLIC_WEB_URL=https://<you>.github.io/perp-duel/
